# ============================================================================
# Angel One SmartAPI Credentials
# ============================================================================
# IMPORTANT: DO NOT commit the actual .env file with real credentials!
# This is a template. Copy to .env and fill in your real values.

# Angel One API Key (from https://smartapi.angelbroking.com/developer)
ANGEL_API_KEY=your_api_key_here

# Angel One Client ID (your trading account ID)
ANGEL_CLIENT_ID=your_client_id_here

# Angel One Password (your trading password)
ANGEL_PASSWORD=your_password_here

# Angel One TOTP Secret (for 2FA authentication)
ANGEL_TOTP_SECRET=your_totp_secret_here

# ============================================================================
# Trading Configuration
# ============================================================================

# Trading Mode: PAPER (for testing) or LIVE (real orders)
TRADING_MODE=PAPER

# Paper Trading Capital (in INR)
PAPER_TRADING_CAPITAL=1000000

# Risk Management
DEFAULT_RISK_PER_TRADE_PCT=1.0
MAX_POSITION_SIZE_PCT=20.0
MAX_OPEN_POSITIONS=5

# Order Defaults
DEFAULT_PRODUCT_TYPE=INTRADAY
DEFAULT_ORDER_TYPE=MARKET
DEFAULT_DURATION=DAY

# Safety
REQUIRE_CONFIRMATION_LIVE=true

# ============================================================================
# Scanner Configuration
# ============================================================================

CANDLE_INTERVAL=FIVE_MINUTE
TOP_N=10
CAPITAL_USD=10000
REFRESH_SECONDS=100

# ============================================================================
# SECURITY NOTES
# ============================================================================
# 1. Never expose these credentials in frontend code
# 2. Never commit .env file to version control
# 3. Use environment variables in production (Vercel secrets)
# 4. Rotate credentials regularly
# 5. Enable IP whitelisting in Angel One dashboard if available
