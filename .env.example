# ─────────────────────────────────────────────────────────────────────────────
# Momentum Signal Tracker – Environment Variables
# Copy this file to .env for local development (never commit .env to git!)
# Set these in Vercel: Project → Settings → Environment Variables
# ─────────────────────────────────────────────────────────────────────────────

# ── Angel One SmartAPI Credentials ───────────────────────────────────────────
# Get these from: https://smartapi.angelone.in → My Profile → API
ANGEL_API_KEY=your_api_key_here
ANGEL_CLIENT_ID=your_client_id_here
ANGEL_PASSWORD=your_trading_password_here
ANGEL_TOTP_SECRET=PX6O7SGZR2DG6GEQDB7XRNCZGY

# ── Trading Mode ──────────────────────────────────────────────────────────────
# PAPER = paper trading (no real orders), LIVE = real orders
# Keep as PAPER until you've tested everything!
TRADING_MODE=PAPER

# ── Session Security ──────────────────────────────────────────────────────────
# Random string for signing session cookies. Auto-generated if not set,
# but setting it means sessions survive Vercel cold-starts.
# Generate one: python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET_KEY=generate_a_random_64_char_hex_string_here

# ── IP Whitelist Proxy (IMPORTANT for Vercel deployment) ──────────────────────
# Vercel runs on AWS US servers. Angel One blocks non-Indian IPs.
#
# OPTION 1: Whitelist the IP manually
#   - Visit https://momentum-signal-tracker.vercel.app/health to see current IP
#   - Add that IP at smartapi.angelone.in → IP Whitelist
#   - ⚠️  Vercel IPs are NOT static — they change on cold starts!
#
# OPTION 2: Use a proxy with a static Indian IP (RECOMMENDED)
#   Services: QuotaGuard Static, Fixie, or any SOCKS5/HTTP proxy
#   Uncomment and fill in one of these:
#
# QUOTAGUARDSTATIC_URL=http://username:password@static.quotaguard.com:9293
# FIXIE_URL=http://username:password@velodrome.usefixie.com:80
# HTTPS_PROXY=http://username:password@your-proxy-host:port
