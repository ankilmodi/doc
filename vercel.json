{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python",
      "config": { "maxLambdaSize": "15mb" }
    },
    {
      "src": "public/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    { "src": "/api/health",     "dest": "api/index.py" },
    { "src": "/api/debug",      "dest": "api/index.py" },
    { "src": "/api/scan",       "dest": "api/index.py" },
    { "src": "/api/scan/table", "dest": "api/index.py" },
    { "src": "/api/scan/csv",   "dest": "api/index.py" },
    { "src": "/api/trading/mode", "dest": "api/index.py" },
    { "src": "/api/trading/stats", "dest": "api/index.py" },
    { "src": "/api/orders/place", "dest": "api/index.py" },
    { "src": "/api/orders/modify", "dest": "api/index.py" },
    { "src": "/api/orders/cancel", "dest": "api/index.py" },
    { "src": "/api/orders/calculate-quantity", "dest": "api/index.py" },
    { "src": "/api/orders/open", "dest": "api/index.py" },
    { "src": "/api/orders/history", "dest": "api/index.py" },
    { "src": "/api/orders", "dest": "api/index.py" },
    { "src": "/api/positions", "dest": "api/index.py" },
    { "src": "/api/trades", "dest": "api/index.py" },
    { "src": "/api/funds", "dest": "api/index.py" },
    { "src": "/", "dest": "public/index.html" },
    { "src": "/(.*)\\.js$", "dest": "public/$1.js" },
    { "src": "/(.*)\\.css$", "dest": "public/$1.css" },
    { "src": "/(.*)\\.html$", "dest": "public/$1.html" },
    { "src": "/(.*)", "dest": "public/$1" }
  ]
}
