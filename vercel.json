{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python",
      "config": { "maxLambdaSize": "15mb" }
    },
    {
      "src": "public/index.html",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    { "src": "/health", "dest": "api/index.py" },
    { "src": "/debug", "dest": "api/index.py" },
    { "src": "/auth/login", "dest": "api/index.py" },
    { "src": "/auth/use-config-credentials", "dest": "api/index.py" },
    { "src": "/scan", "dest": "api/index.py" },
    { "src": "/scan/table", "dest": "api/index.py" },
    { "src": "/scan/csv", "dest": "api/index.py" },
    { "src": "/trading/mode", "dest": "api/index.py" },
    { "src": "/trading/stats", "dest": "api/index.py" },
    { "src": "/orders/place", "dest": "api/index.py" },
    { "src": "/orders/modify", "dest": "api/index.py" },
    { "src": "/orders/cancel", "dest": "api/index.py" },
    { "src": "/orders/calculate-quantity", "dest": "api/index.py" },
    { "src": "/orders/open", "dest": "api/index.py" },
    { "src": "/orders/history", "dest": "api/index.py" },
    { "src": "/orders", "dest": "api/index.py" },
    { "src": "/positions", "dest": "api/index.py" },
    { "src": "/trades", "dest": "api/index.py" },
    { "src": "/funds", "dest": "api/index.py" },
    { "src": "/", "dest": "public/index.html" },
    { "src": "/(.*\\.js)", "dest": "public/$1" },
    { "src": "/(.*\\.css)", "dest": "public/$1" },
    { "src": "/(.*\\.html)", "dest": "public/$1" }
  ]
}
